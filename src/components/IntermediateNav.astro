---
interface Props { current: 'overview' | '1-1' | '1-2' | '1-3' | '1-4' | '2-1' | '2-2' | '2-3' | '2-4' | '2-5' | '2-6' | '2-7' | '3-1' | '3-2' | '3-3' | '3-4' | '3-5'; }
const { current } = Astro.props;
const base = import.meta.env.BASE_URL;
const chapters = [
  { number: '1', label: 'Chapter 1 · Foundation', items: [
    ['1-1', '1.1 · Wintertodt foundation'],
    ['1-2', '1.2 · Fishing & Thieving'],
    ['1-3', '1.3 · Bird runs & infrastructure'],
    ['1-4', '1.4 · Farming, DT & earth orbs'],
  ] },
  { number: '2', label: 'Chapter 2 · Quest-ready account', items: [
    ['2-1', '2.1 · Cash & Construction'],
    ['2-2', '2.2 · Quest Infrastructure'],
    ['2-3', '2.3 · Sailing, Combat & the Kingdom'],
    ['2-4', '2.4 · Lunar, Cooking & Recipe for Disaster'],
    ['2-5', '2.5 · Defender, Piety & Morytania'],
    ['2-6', '2.6 · The 70s & SotE prep'],
    ['2-7', '2.7 · The Elf Finale'],
  ] },
  { number: '3', label: 'Chapter 3 · Quest Cape', items: [
    ['3-1', '3.1 · Slayer Foundation & WGS'],
    ['3-2', '3.2 · Varlamore & Runecraft'],
    ['3-3', '3.3 · Ranged & Fire Cape'],
    ['3-4', '3.4 · Slayer, MM2 & Theatre'],
    ['3-5', '3.5 · Dragons & the Fallen Empire'],
  ] },
] as const;
---
<div class="sidebar-card intermediate-nav-card">
  <h2>Intermediate guide</h2>
  <a class={current === 'overview' ? 'active' : undefined} aria-current={current === 'overview' ? 'page' : undefined} href={`${base}intermediate/`}>Overview</a>
  {chapters.map((chapter) =>
    <details class="intermediate-nav-group" open={current.startsWith(`${chapter.number}-`)}>
      <summary>{chapter.label}</summary>
      <div class="intermediate-nav-links">
        {chapter.items.map(([key, label]) =>
          <a class={current === key ? 'active' : undefined} aria-current={current === key ? 'page' : undefined} href={`${base}intermediate/chapter-${key}/`}>{label}</a>
        )}
      </div>
    </details>
  )}
  <small>Each subsection is its own page so the route stays readable instead of becoming one enormous scroll.</small>
</div>
