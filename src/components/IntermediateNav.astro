---
interface Props { current: 'overview' | '1-1' | '1-2' | '1-3' | '1-4' | '2-1' | '2-2' | '2-3' | '2-4' | '2-5' | '2-6'; }
const { current } = Astro.props;
const base = import.meta.env.BASE_URL;
const items = [
  ['overview', 'Overview', `${base}intermediate/`],
  ['1-1', '1.1 · Wintertodt foundation', `${base}intermediate/chapter-1-1/`],
  ['1-2', '1.2 · Fishing & Thieving', `${base}intermediate/chapter-1-2/`],
  ['1-3', '1.3 · Bird runs & infrastructure', `${base}intermediate/chapter-1-3/`],
  ['1-4', '1.4 · Farming, DT & earth orbs', `${base}intermediate/chapter-1-4/`],
  ['2-1', '2.1 · Cash & Construction', `${base}intermediate/chapter-2-1/`],
  ['2-2', '2.2 · Quest Infrastructure', `${base}intermediate/chapter-2-2/`],
  ['2-3', '2.3 · Sailing, Combat & the Kingdom', `${base}intermediate/chapter-2-3/`],
  ['2-4', '2.4 · Lunar, Cooking & Recipe for Disaster', `${base}intermediate/chapter-2-4/`],
  ['2-5', '2.5 · Defender, Piety & Morytania', `${base}intermediate/chapter-2-5/`],
  ['2-6', '2.6 · The 70s & SotE prep', `${base}intermediate/chapter-2-6/`],
] as const;
---
<div class="sidebar-card intermediate-nav-card">
  <h2>Intermediate guide</h2>
  {items.map(([key, label, href]) => <a class={current === key ? 'active' : undefined} href={href}>{label}</a>)}
  <small>Each subsection is its own page so the route stays readable instead of becoming one enormous scroll.</small>
</div>
