---
interface Props {
  title?: string;
  summary: string;
  stats?: string[];
  unlocks?: string[];
}
const { title = 'Where this section is going', summary, stats = [], unlocks = [] } = Astro.props;
---
<section class="goal-panel" aria-labelledby="chapter-goals-heading">
  <div class="section-label">Goals first</div>
  <h2 id="chapter-goals-heading">{title}</h2>
  <p>{summary}</p>
  {(stats.length > 0 || unlocks.length > 0) && (
    <div class="goal-columns">
      {stats.length > 0 && <div><h3>Target progress</h3><ul>{stats.map((item) => <li>{item}</li>)}</ul></div>}
      {unlocks.length > 0 && <div><h3>Major unlocks</h3><ul>{unlocks.map((item) => <li>{item}</li>)}</ul></div>}
    </div>
  )}
</section>
