---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'chapter' | 'feedback' | 'companion';
}
const { title, description = 'A fun-first Old School RuneScape Ironman adventure guide.', current } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="header-inner">
          <a class="brand" href={base}><span>RuneScape</span> Adventure Guide</a>
          <nav class="main-nav" aria-label="Main navigation">
            <a href={base} aria-current={current === 'home' ? 'page' : undefined}>Home</a>
            <a href={`${base}chapters/chapter-1/`} aria-current={current === 'chapter' ? 'page' : undefined}>Chapter 1</a>
            <a href={`${base}feedback/`} aria-current={current === 'feedback' ? 'page' : undefined}>Feedback</a>
          </nav>
        </div>
      </header>
      <main><slot /></main>
      <footer class="footer">
        <span>Built for discovery, not maximum efficiency.</span>
        <button class="footer-admin-link" type="button" data-companion-open>Companion access</button>
      </footer>
    </div>

    <dialog class="pin-dialog" data-pin-dialog>
      <form method="dialog" class="pin-card" data-pin-form>
        <button class="dialog-close" type="button" aria-label="Close companion access" data-pin-close>×</button>
        <div class="section-label">Companion access</div>
        <h2>Enter the guide PIN</h2>
        <p>These notes contain quest, encounter, and progression spoilers.</p>
        <label for="companion-pin">PIN</label>
        <input id="companion-pin" name="pin" type="password" inputmode="numeric" autocomplete="off" required />
        <p class="form-error" data-pin-error aria-live="polite"></p>
        <button class="button" type="submit">Unlock notes</button>
      </form>
    </dialog>

    <script define:vars={{ base }}>
      const companionPin = '2007';
      const storageKey = 'rsag-companion-unlocked';
      const dialog = document.querySelector('[data-pin-dialog]');
      const openButton = document.querySelector('[data-companion-open]');
      const closeButton = document.querySelector('[data-pin-close]');
      const form = document.querySelector('[data-pin-form]');
      const input = document.querySelector('#companion-pin');
      const error = document.querySelector('[data-pin-error]');

      openButton?.addEventListener('click', () => {
        if (localStorage.getItem(storageKey) === 'true') {
          window.location.href = `${base}companion/chapter-1/`;
          return;
        }
        error.textContent = '';
        input.value = '';
        dialog?.showModal();
        window.setTimeout(() => input?.focus(), 30);
      });

      closeButton?.addEventListener('click', () => dialog?.close());

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (input.value === companionPin) {
          localStorage.setItem(storageKey, 'true');
          dialog?.close();
          window.location.href = `${base}companion/chapter-1/`;
          return;
        }
        error.textContent = 'That PIN did not match.';
        input.select();
      });
    </script>
  </body>
</html>
